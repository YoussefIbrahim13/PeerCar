@using Microsoft.AspNetCore.Identity
@using Peer_Car.Domain.Entities
@inject UserManager<User> UserManager

@{
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    bool isAdmin = User.IsInRole("Admin");
    bool fullBleed = ViewData["FullBleed"] as bool? == true;
    bool hideFooter = ViewData["HideFooter"] != null;

    User? currentUser = isAuthenticated ? await UserManager.GetUserAsync(User) : null;
    string displayName = currentUser?.FirstName ?? User.Identity?.Name ?? "User";
    string initials = string.Concat(new[] { currentUser?.FirstName, currentUser?.LastName }
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .Select(s => char.ToUpperInvariant(s!.Trim()[0])));
    if (string.IsNullOrEmpty(initials)) { initials = displayName.Length > 0 ? displayName[..1].ToUpperInvariant() : "U"; }
    string? profileImg = string.IsNullOrEmpty(currentUser?.ProfileImageUrl) || currentUser!.ProfileImageUrl == "default.png"
        ? null
        : "/images/profiles/" + currentUser.ProfileImageUrl;
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f6fb" />
    <meta name="description" content="PeerCar — rent cars from people near you, or earn by sharing yours." />
    <title>@(ViewData["Title"] is string t && t.Length > 0 ? $"{t} · PeerCar" : "PeerCar")</title>

    @* Apply the saved / system theme before first paint to avoid a flash *@
    <script>
        (function () {
            var d = document.documentElement; d.classList.add('js');
            var t = null; try { t = localStorage.getItem('pc-theme'); } catch (e) { }
            if (!t) t = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            d.setAttribute('data-bs-theme', t);
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Cairo:wght@400;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(fullBleed ? "pc-has-hero" : null)">
    <div class="pc-progress" aria-hidden="true"></div>

    <header class="pc-header">
        <nav class="navbar navbar-expand-lg pc-navbar" aria-label="Main">
            <div class="container">
                <a class="pc-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="PeerCar home">
                    <span class="pc-brand-mark"><i class="bi bi-car-front-fill"></i></span>
                    <span>Peer<b>Car</b></span>
                </a>

                <div class="d-flex align-items-center gap-2 d-lg-none">
                    <button type="button" class="pc-icon-btn pc-theme-toggle" data-theme-toggle aria-label="Toggle dark mode">
                        <i class="bi bi-moon-stars"></i><i class="bi bi-sun"></i>
                    </button>
                    <button class="pc-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#pcNav" aria-controls="pcNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span></span>
                    </button>
                </div>

                <div class="collapse navbar-collapse" id="pcNav">
                    <ul class="navbar-nav mx-lg-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Cars" asp-action="Index"><i class="bi bi-grid-1x2"></i> Explore</a>
                        </li>

                        @if (isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-ai" asp-area="" asp-controller="Chatbot" asp-action="Index">
                                    <i class="bi bi-stars"></i> AI Assistant <span class="pc-ai-dot" aria-hidden="true"></span>
                                </a>
                            </li>
                        }

                        @if (isAuthenticated && !isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Bookings" asp-action="MyBookings"><i class="bi bi-calendar-check"></i> My Trips</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-key"></i> Hosting
                                </a>
                                <ul class="dropdown-menu">
                                    <li><h6 class="dropdown-header">Share your car</h6></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Cars" asp-action="Submit"><i class="bi bi-plus-circle me-2"></i>Submit a car</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Cars" asp-action="MyCars"><i class="bi bi-car-front me-2"></i>My cars</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Bookings" asp-action="MyCarsBookings"><i class="bi bi-calendar-range me-2"></i>Bookings on my cars</a></li>
                                </ul>
                            </li>
                        }

                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Admin" asp-action="UserReservations"><i class="bi bi-journal-text"></i> Reservations</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-grid"></i> Admin
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                    <li><h6 class="dropdown-header">Control center</h6></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users"><i class="bi bi-people me-2"></i>Users</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Cars"><i class="bi bi-car-front me-2"></i>Cars</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Bookings"><i class="bi bi-calendar2-check me-2"></i>Bookings</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><h6 class="dropdown-header">Review queues</h6></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="PendingVerifications"><i class="bi bi-shield-check me-2"></i>User verifications</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="CarSubmissions"><i class="bi bi-file-earmark-check me-2"></i>Car submissions</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item text-danger" asp-controller="Admin" asp-action="Archive"><i class="bi bi-archive me-2"></i>System archive</a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2 pc-nav-actions">
                        <button type="button" class="pc-icon-btn pc-theme-toggle d-none d-lg-inline-grid" data-theme-toggle aria-label="Toggle dark mode" title="Toggle theme">
                            <i class="bi bi-moon-stars"></i><i class="bi bi-sun"></i>
                        </button>

                        @if (isAuthenticated)
                        {
                            <div class="dropdown">
                                <button class="pc-user-btn dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    @if (profileImg != null)
                                    {
                                        <img src="@profileImg" alt="" data-fallback="/images/profiles/default.png" />
                                    }
                                    else
                                    {
                                        <span class="pc-avatar" aria-hidden="true">@initials</span>
                                    }
                                    <span>@displayName</span>
                                    <i class="bi bi-chevron-down small text-muted"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li class="px-3 pt-2 pb-1">
                                        <div class="fw-bold">@(currentUser?.FullName ?? displayName)</div>
                                        <div class="small text-muted text-truncate" style="max-width: 220px;">@currentUser?.Email</div>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    @if (!isAdmin)
                                    {
                                        <li><a class="dropdown-item" asp-controller="Bookings" asp-action="MyBookings"><i class="bi bi-calendar-check me-2"></i>My bookings</a></li>
                                    }
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="MyAccount"><i class="bi bi-person-badge me-2"></i>My account</a></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="EditProfile"><i class="bi bi-sliders me-2"></i>Edit profile</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" data-no-loading>
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i>Sign out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-light rounded-pill px-3">Sign in</a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-primary rounded-pill px-3">
                                Get started <i class="bi bi-arrow-right-short"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @* Flash messages become toasts *@
    @{
        var flashes = new (string Key, string Kind, string Icon)[]
        {
            ("SuccessMessage", "success", "bi-check2-circle"),
            ("ToastSuccess", "success", "bi-check2-circle"),
            ("ErrorMessage", "error", "bi-exclamation-octagon"),
            ("ToastError", "error", "bi-exclamation-octagon"),
            ("InfoMessage", "info", "bi-info-circle")
        };
    }
    <div class="pc-toasts" aria-live="polite">
        @foreach (var f in flashes)
        {
            if (TempData[f.Key] is object msg && msg.ToString() is string text && text.Length > 0)
            {
                <div class="pc-toast is-@f.Kind" role="@(f.Kind == "error" ? "alert" : "status")">
                    <div class="pc-toast-icon"><i class="bi @f.Icon"></i></div>
                    <div class="pc-toast-body">@text</div>
                    <button type="button" class="pc-toast-close" aria-label="Close"><i class="bi bi-x-lg"></i></button>
                    <span class="pc-toast-timer"></span>
                </div>
            }
        }
    </div>

    @if (fullBleed)
    {
        <main role="main" class="pc-main pb-5">
            @RenderBody()
        </main>
    }
    else
    {
        <div class="container mt-3 mt-lg-4">
            <main role="main" class="pc-main pb-5">
                @RenderBody()
            </main>
        </div>
    }

    @if (!hideFooter)
    {
        <footer class="pc-footer">
            <div class="container">
                <div class="row g-4">
                    <div class="col-lg-4">
                        <a class="pc-brand mb-3" asp-controller="Home" asp-action="Index">
                            <span class="pc-brand-mark"><i class="bi bi-car-front-fill"></i></span>
                            <span>Peer<b>Car</b></span>
                        </a>
                        <p class="text-muted mt-3 mb-4" style="max-width: 34ch;">Rent the car you want from people near you — or earn from the one sitting in your driveway.</p>
                        <div class="pc-social">
                            <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                            <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                            <a href="#" aria-label="X"><i class="bi bi-twitter-x"></i></a>
                            <a href="#" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                        </div>
                    </div>
                    <div class="col-6 col-lg-2 offset-lg-2">
                        <h6>Explore</h6>
                        <ul>
                            <li><a asp-controller="Cars" asp-action="Index">Browse cars</a></li>
                            <li><a asp-controller="Reviews" asp-action="Index">Reviews</a></li>
                            @if (isAuthenticated)
                            {
                                <li><a asp-controller="Chatbot" asp-action="Index">AI Assistant</a></li>
                            }
                        </ul>
                    </div>
                    <div class="col-6 col-lg-2">
                        <h6>Hosting</h6>
                        <ul>
                            <li><a asp-controller="Cars" asp-action="Submit">List your car</a></li>
                            <li><a asp-controller="Cars" asp-action="MyCars">My cars</a></li>
                            <li><a asp-controller="Bookings" asp-action="MyCarsBookings">Requests</a></li>
                        </ul>
                    </div>
                    <div class="col-6 col-lg-2">
                        <h6>Company</h6>
                        <ul>
                            <li><a asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                            <li><a asp-controller="Account" asp-action="MyAccount">Account</a></li>
                        </ul>
                    </div>
                </div>
                <div class="pc-footer-bottom small">
                    <span>&copy; @DateTime.Now.Year PeerCar. All rights reserved.</span>
                    <span>Made for drivers, by drivers <i class="bi bi-heart-fill text-danger"></i></span>
                </div>
            </div>
        </footer>
    }

    <button type="button" class="pc-to-top" aria-label="Back to top">
        <svg viewBox="0 0 52 52" aria-hidden="true"><circle cx="26" cy="26" r="24"></circle></svg>
        <i class="bi bi-arrow-up"></i>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
