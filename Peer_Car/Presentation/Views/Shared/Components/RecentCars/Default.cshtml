@model IEnumerable<Peer_Car.Application.ViewModels.CarViewModel>

@if (!Model.Any())
{
    <div class="col-12">
        <div class="pc-empty">
            <span class="pc-icon-tile"><i class="bi bi-car-front"></i></span>
            <h3 class="h5">No cars listed yet</h3>
            <p class="text-muted mb-0">Be the first to share your car with the community.</p>
        </div>
    </div>
}
else
{
    foreach (var car in Model)
    {
        <partial name="_CarCard" model="car" />
    }
}
