@using Peer_Car.Domain.Entities
@model IEnumerable<Car>

@* Renders entity cars with the same card design as _CarCard *@
@if (!Model.Any())
{
    <div class="col-12">
        <div class="pc-empty">
            <span class="pc-icon-tile"><i class="bi bi-car-front"></i></span>
            <h3 class="h5">No cars available at the moment</h3>
        </div>
    </div>
}
else
{
    foreach (var car in Model)
    {
        var vm = new Peer_Car.Application.ViewModels.CarViewModel
        {
            Id = car.Id,
            Brand = car.Brand,
            Model = car.Model,
            Year = car.Year,
            PricePerDay = car.PricePerDay,
            Location = car.Location,
            ImagePath = car.ImagePath,
            OwnerId = car.OwnerId,
            AvailabilityStatus = car.AvailabilityStatus,
            SubmissionStatus = car.SubmissionStatus,
            AverageRating = car.Reviews.Any() ? Math.Round(car.Reviews.Average(r => r.Rating), 1) : 0,
            TotalReviews = car.Reviews.Count
        };
        <partial name="_CarCard" model="vm" />
    }
}
