@using Peer_Car.Domain.Entities
@using Peer_Car.Domain.Enums
@model Peer_Car.Application.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    int totalCars = Model.TotalCars;
    int availableCars = Model.AvailableCars;
    int availablePct = totalCars > 0 ? (int)Math.Round(availableCars * 100.0 / totalCars) : 0;
    int hour = DateTime.Now.Hour;
    string greeting = hour >= 18 ? "Good evening" : hour >= 12 ? "Good afternoon" : "Good morning";
}

<section class="hero-section mb-4">
    <div class="container">
        <div class="d-flex flex-wrap align-items-end justify-content-between gap-3">
            <div>
                <span class="pc-pill animate__animated animate__fadeInDown"><i class="bi bi-speedometer2"></i> Control center</span>
                <h1 class="mt-3 mb-2 animate__animated animate__fadeInUp">@greeting, Admin</h1>
                <p class="lead mb-0 animate__animated animate__fadeInUp">Here's what's happening on PeerCar today — @DateTime.Now.ToString("dddd, MMM d").</p>
            </div>
            <div class="d-flex flex-wrap gap-2 animate__animated animate__fadeInUp">
                <a asp-action="AddUser" class="btn btn-glass rounded-pill"><i class="bi bi-person-plus me-1"></i> Add user</a>
                <a asp-action="CarSubmissions" class="btn btn-light rounded-pill"><i class="bi bi-inbox me-1"></i> Review queue</a>
            </div>
        </div>
    </div>
</section>

<div class="row g-4 mb-4" data-reveal-stagger="0.08">
    <div class="col-sm-6 col-xl-3">
        <a class="pc-stat pc-spotlight" asp-action="Users">
            <div class="d-flex justify-content-between align-items-start">
                <span class="pc-icon-tile"><i class="bi bi-people-fill"></i></span>
                <span class="badge bg-success"><i class="bi bi-arrow-up-short"></i>@Model.NewUsersToday today</span>
            </div>
            <div class="value" data-count="@Model.TotalUsers">@Model.TotalUsers</div>
            <div class="label">Total users</div>
            <i class="bi bi-people spark" aria-hidden="true"></i>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a class="pc-stat pc-spotlight" asp-action="Cars">
            <div class="d-flex justify-content-between align-items-start">
                <span class="pc-icon-tile is-success"><i class="bi bi-car-front-fill"></i></span>
                <span class="badge bg-light">@availableCars available</span>
            </div>
            <div class="value" data-count="@totalCars">@totalCars</div>
            <div class="label">Total cars</div>
            <div class="progress mt-3" style="height:6px" role="progressbar" aria-label="Available cars" aria-valuenow="@availablePct" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar" style="width:@availablePct%"></div>
            </div>
            <i class="bi bi-car-front spark" aria-hidden="true"></i>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a class="pc-stat pc-spotlight" asp-action="CarSubmissions">
            <div class="d-flex justify-content-between align-items-start">
                <span class="pc-icon-tile is-warning"><i class="bi bi-hourglass-split"></i></span>
                @if (Model.PendingSubmissions > 0)
                {
                    <span class="badge bg-warning badge-dot">Needs review</span>
                }
            </div>
            <div class="value" data-count="@Model.PendingSubmissions">@Model.PendingSubmissions</div>
            <div class="label">Pending submissions</div>
            <i class="bi bi-file-earmark-medical spark" aria-hidden="true"></i>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a class="pc-stat is-grad" asp-action="Bookings">
            <div class="d-flex justify-content-between align-items-start">
                <span class="pc-icon-tile" style="background:rgba(255,255,255,.18);color:#fff"><i class="bi bi-calendar2-check"></i></span>
                <i class="bi bi-arrow-up-right"></i>
            </div>
            <div class="value" data-count="@Model.TotalBookings">@Model.TotalBookings</div>
            <div class="label">Platform bookings</div>
            <i class="bi bi-calendar-check spark" aria-hidden="true"></i>
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h2 class="h6 mb-0">Quick actions</h2>
                <i class="bi bi-lightning-charge text-warning"></i>
            </div>
            <div class="list-group list-group-flush p-2">
                <a asp-action="AddUser" class="list-group-item list-group-item-action border-0 rounded-3 d-flex align-items-center gap-3 py-3">
                    <span class="pc-icon-tile" style="width:40px;height:40px;font-size:1rem"><i class="bi bi-person-plus"></i></span>
                    <span class="flex-grow-1 fw-semibold">Add a new user</span><i class="bi bi-chevron-right text-muted"></i>
                </a>
                <a asp-action="CarSubmissions" class="list-group-item list-group-item-action border-0 rounded-3 d-flex align-items-center gap-3 py-3">
                    <span class="pc-icon-tile is-warning" style="width:40px;height:40px;font-size:1rem"><i class="bi bi-card-checklist"></i></span>
                    <span class="flex-grow-1 fw-semibold">Review submissions <span class="badge bg-warning ms-1">@Model.PendingSubmissions</span></span><i class="bi bi-chevron-right text-muted"></i>
                </a>
                <a asp-action="PendingVerifications" class="list-group-item list-group-item-action border-0 rounded-3 d-flex align-items-center gap-3 py-3">
                    <span class="pc-icon-tile is-success" style="width:40px;height:40px;font-size:1rem"><i class="bi bi-shield-check"></i></span>
                    <span class="flex-grow-1 fw-semibold">Verify user documents</span><i class="bi bi-chevron-right text-muted"></i>
                </a>
                <a asp-action="Bookings" asp-route-status="Pending" class="list-group-item list-group-item-action border-0 rounded-3 d-flex align-items-center gap-3 py-3">
                    <span class="pc-icon-tile is-info" style="width:40px;height:40px;font-size:1rem"><i class="bi bi-alarm"></i></span>
                    <span class="flex-grow-1 fw-semibold">Pending bookings</span><i class="bi bi-chevron-right text-muted"></i>
                </a>
                <a asp-action="Archive" class="list-group-item list-group-item-action border-0 rounded-3 d-flex align-items-center gap-3 py-3">
                    <span class="pc-icon-tile is-danger" style="width:40px;height:40px;font-size:1rem"><i class="bi bi-archive"></i></span>
                    <span class="flex-grow-1 fw-semibold">System archive</span><i class="bi bi-chevron-right text-muted"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="h6 mb-0">Recent activity</h2>
                    <div class="small text-muted">Latest bookings across the platform</div>
                </div>
                <a asp-action="Bookings" class="btn btn-sm btn-light rounded-pill">View all <i class="bi bi-arrow-right"></i></a>
            </div>
            @if (!Model.RecentBookings.Any())
            {
                <div class="card-body">
                    <div class="pc-empty border-0 py-4">
                        <span class="pc-icon-tile"><i class="bi bi-calendar-x"></i></span>
                        <h3 class="h6">No bookings yet</h3>
                        <p class="small text-muted mb-0">New reservations will show up here.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Vehicle</th>
                                <th>Customer</th>
                                <th>Status</th>
                                <th class="text-end pe-4"><span class="visually-hidden">Open</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var booking in Model.RecentBookings.Take(6))
                            {
                                var badgeClass = booking.Status switch
                                {
                                    BookingStatus.Pending => "warning",
                                    BookingStatus.Confirmed => "success",
                                    BookingStatus.Cancelled => "danger",
                                    BookingStatus.Completed => "info",
                                    _ => "secondary"
                                };
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <span class="pc-icon-tile" style="width:40px;height:40px;font-size:1rem"><i class="bi bi-car-front"></i></span>
                                            <div>
                                                <div class="fw-bold">@booking.Car?.Brand @booking.Car?.Model</div>
                                                <small class="text-muted"><i class="bi bi-calendar3 me-1"></i>@booking.StartDate.ToString("MMM dd") → @booking.EndDate.ToString("MMM dd")</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold">@booking.Renter?.FullName</div>
                                        <div class="small text-muted">@booking.Renter?.Email</div>
                                    </td>
                                    <td><span class="badge bg-@badgeClass badge-dot">@booking.Status</span></td>
                                    <td class="text-end pe-4">
                                        <a asp-action="BookingDetails" asp-route-id="@booking.Id" class="pc-icon-btn" aria-label="Open booking"><i class="bi bi-chevron-right"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
