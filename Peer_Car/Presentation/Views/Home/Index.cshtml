@using Microsoft.AspNetCore.Identity
@using Peer_Car.Domain.Entities
@inject SignInManager<User> SignInManager

@{
    ViewData["Title"] = "Rent cars from people near you";
    ViewData["FullBleed"] = true;
    bool signedIn = SignInManager.IsSignedIn(User);
    bool isAdmin = signedIn && User.IsInRole("Admin");
}

<!-- ============ HERO ============ -->
<section class="pc-hero">
    <span class="pc-blob b1" aria-hidden="true"></span>
    <span class="pc-blob b2" aria-hidden="true"></span>
    <span class="pc-blob b3" aria-hidden="true"></span>
    <div class="pc-hero-grid" aria-hidden="true"></div>

    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="pc-pill animate__animated animate__fadeInDown">
                    <span class="tag">New</span> AI trip assistant is live <i class="bi bi-arrow-right-short"></i>
                </span>
                <h1 class="mt-4 mb-4 animate__animated animate__fadeInUp">
                    Drive the car you <span class="text-gradient">actually want.</span>
                </h1>
                <p class="lead mb-4 animate__animated animate__fadeInUp" style="animation-delay:.1s">
                    PeerCar connects you with verified local owners. Book in minutes, pick up nearby, and hit the road — no rental counter required.
                </p>

                <form asp-controller="Cars" asp-action="Index" method="get" class="pc-search animate__animated animate__fadeInUp" style="animation-delay:.2s" role="search" data-no-loading>
                    <div class="pc-search-field">
                        <i class="bi bi-car-front"></i>
                        <div class="flex-grow-1">
                            <label for="heroBrand">Brand</label>
                            <input id="heroBrand" name="brand" type="text" placeholder="Any brand" autocomplete="off" />
                        </div>
                    </div>
                    <div class="pc-search-field">
                        <i class="bi bi-cash-coin"></i>
                        <div class="flex-grow-1">
                            <label for="heroPrice">Budget / day</label>
                            <select id="heroPrice" name="priceRange">
                                <option value="">Any price</option>
                                <option value="0-2000">Under 2,000 SAR</option>
                                <option value="2000-4000">2,000 – 4,000 SAR</option>
                                <option value="4000-6000">4,000 – 6,000 SAR</option>
                                <option value="6000+">6,000+ SAR</option>
                            </select>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg px-4">
                        <i class="bi bi-search me-1"></i> Search
                    </button>
                </form>

                <div class="pc-stats mt-5 animate__animated animate__fadeIn" style="animation-delay:.35s">
                    <div><div class="num"><span data-count="100" data-suffix="%">100%</span></div><div class="lbl">Verified owners</div></div>
                    <div><div class="num"><span data-count="24" data-suffix="/7">24/7</span></div><div class="lbl">AI support</div></div>
                    <div><div class="num"><span data-count="0" data-suffix=" fees">0 fees</span></div><div class="lbl">Hidden charges</div></div>
                </div>
            </div>

            <div class="col-lg-5 d-none d-lg-block">
                <div class="pc-hero-visual animate__animated animate__zoomIn" style="animation-delay:.2s">
                    <div class="pc-hero-card" data-tilt="10">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="pc-pill"><i class="bi bi-lightning-charge-fill text-warning"></i> Instant booking</span>
                            <span class="small text-white-50">Today</span>
                        </div>
                        <div class="pc-hero-car my-3"><i class="bi bi-car-front-fill"></i></div>
                        <div class="pc-road"></div>
                        <div class="d-flex justify-content-between align-items-end">
                            <div>
                                <div class="small text-white-50">Pick-up</div>
                                <div class="fw-bold">Near you</div>
                            </div>
                            <a asp-controller="Cars" asp-action="Index" class="btn btn-glass rounded-pill btn-sm px-3">Explore <i class="bi bi-arrow-right"></i></a>
                        </div>
                    </div>

                    <div class="pc-float-chip" style="top:-18px; left:-34px;">
                        <span class="ic" style="background:linear-gradient(135deg,#10b981,#06b6d4)"><i class="bi bi-shield-check"></i></span>
                        <div>ID verified<small>Every host & renter</small></div>
                    </div>
                    <div class="pc-float-chip" style="bottom:-30px; left:28px; animation-delay:-3s">
                        <span class="ic" style="background:linear-gradient(135deg,#f59e0b,#ec4899)"><i class="bi bi-star-fill"></i></span>
                        <div>Rated by drivers<small>Real reviews only</small></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============ BRAND MARQUEE ============ -->
<section class="py-4 py-lg-5">
    <div class="container">
        <p class="text-center text-muted small fw-semibold text-uppercase mb-3" style="letter-spacing:.14em">From city runabouts to weekend toys</p>
        <div class="pc-marquee" aria-hidden="true">
            <div class="pc-marquee-track">
                @for (int i = 0; i < 2; i++)
                {
                    foreach (var b in new[] { "BMW", "Mercedes-Benz", "Tesla", "Toyota", "Hyundai", "Kia", "Audi", "Nissan", "Porsche", "Jeep", "Volkswagen", "Lexus" })
                    {
                        <span>@b</span>
                    }
                }
            </div>
        </div>
    </div>
</section>

<!-- ============ QUICK ACTIONS ============ -->
<section class="container pc-section pt-2">
    <div class="pc-page-head" data-reveal>
        <div>
            <span class="eyebrow">Get going</span>
            <h2 class="section-title mt-2">Everything in one place</h2>
            <p class="section-sub mb-0">Jump straight to what you need — browsing, managing trips, or tuning your profile.</p>
        </div>
    </div>

    @{
        var bookingController = isAdmin ? "Admin" : "Bookings";
        var bookingAction = isAdmin ? "UserReservations" : "MyBookings";
    }
    <div class="row g-4" data-reveal-stagger="0.1">
        <div class="col-md-4">
            <a class="pc-feature pc-spotlight" asp-controller="Cars" asp-action="Index">
                <span class="pc-icon-tile is-grad"><i class="bi bi-search-heart"></i></span>
                <h3>Find a ride</h3>
                <p>Explore cars shared by verified owners, filter by brand and budget, and book in a few taps.</p>
                <span class="pc-link">Browse cars <i class="bi bi-arrow-right"></i></span>
            </a>
        </div>
        <div class="col-md-4">
            <a class="pc-feature pc-spotlight" asp-controller="@bookingController" asp-action="@bookingAction">
                <span class="pc-icon-tile is-success"><i class="bi @(isAdmin ? "bi-shield-check" : "bi-calendar2-check")"></i></span>
                <h3>@(isAdmin ? "Platform reservations" : "My trips")</h3>
                <p>@(isAdmin ? "Monitor every active booking on the platform in real time." : "Track upcoming rentals, payments and key hand-overs at a glance.")</p>
                <span class="pc-link">View details <i class="bi bi-arrow-right"></i></span>
            </a>
        </div>
        <div class="col-md-4">
            <a class="pc-feature pc-spotlight" asp-controller="Account" asp-action="@(signedIn ? "EditProfile" : "Login")">
                <span class="pc-icon-tile is-info"><i class="bi bi-person-gear"></i></span>
                <h3>@(signedIn ? "Your profile" : "Your account")</h3>
                <p>Update your details, photo and verification documents to unlock faster approvals.</p>
                <span class="pc-link">@(signedIn ? "Edit my data" : "Sign in") <i class="bi bi-arrow-right"></i></span>
            </a>
        </div>
    </div>
</section>

<!-- ============ RECENT CARS ============ -->
<section class="container pc-section pt-0">
    <div class="pc-page-head" data-reveal>
        <div>
            <span class="eyebrow">Fresh on PeerCar</span>
            <h2 class="section-title mt-2">Recently added</h2>
            <p class="section-sub mb-0">The newest cars from our community of owners.</p>
        </div>
        <a asp-controller="Cars" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">View all <i class="bi bi-arrow-right"></i></a>
    </div>

    <div class="row g-4" data-reveal-stagger="0.08">
        @await Component.InvokeAsync("RecentCars")
    </div>
</section>

<!-- ============ HOW IT WORKS ============ -->
<section class="container pc-section pt-0">
    <div class="text-center mb-5" data-reveal>
        <span class="eyebrow">How it works</span>
        <h2 class="section-title mt-2">On the road in three steps</h2>
    </div>
    <div class="row g-4" data-reveal-stagger="0.12">
        <div class="col-md-4">
            <div class="pc-feature">
                <div class="pc-step-num">01</div>
                <h3>Pick your car</h3>
                <p>Filter by brand and budget, read real reviews, and compare owners.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="pc-feature">
                <div class="pc-step-num">02</div>
                <h3>Book & verify</h3>
                <p>Choose your dates — the price is calculated instantly. Your ID keeps everyone safe.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="pc-feature">
                <div class="pc-step-num">03</div>
                <h3>Grab the keys</h3>
                <p>Meet the owner, confirm the hand-over in the app, and enjoy the drive.</p>
            </div>
        </div>
    </div>
</section>

<!-- ============ CTA ============ -->
<section class="container pb-4">
    @if (isAdmin)
    {
        <div class="pc-cta" data-reveal="zoom">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <h2 class="mb-2"><i class="bi bi-speedometer2 me-2"></i>Admin control center</h2>
                    <p class="mb-0">Direct access to users, the vehicle fleet, review queues and platform-wide analytics.</p>
                </div>
                <div class="col-lg-4 d-flex flex-wrap gap-2 justify-content-lg-end">
                    <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-light btn-lg rounded-pill px-4">Open dashboard <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="pc-cta" data-reveal="zoom">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <h2 class="mb-2">Your car could be earning right now.</h2>
                    <p class="mb-0">List it in minutes. We verify every renter, and you stay in control of every booking.</p>
                </div>
                <div class="col-lg-4 d-flex flex-wrap gap-2 justify-content-lg-end">
                    <a asp-controller="@(signedIn ? "Cars" : "Account")" asp-action="@(signedIn ? "Submit" : "Register")" class="btn btn-light btn-lg rounded-pill px-4">
                        @(signedIn ? "List my car" : "Join PeerCar") <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    }
</section>
