@using Peer_Car.Application.ViewModels
@model RegisterViewModel

@{
    ViewData["Title"] = "Create your account";
    ViewData["AuthHeading"] = "Rent smarter. Share easier.";
    ViewData["AuthSub"] = "Create a free account to book cars or start earning from yours.";
}

<div class="pc-auth animate__animated animate__fadeInUp">
    <partial name="_AuthArt" />

    <section class="pc-auth-form">
        <div class="mx-auto w-100" style="max-width: 520px;">
            <span class="eyebrow">Sign up</span>
            <h1 class="mt-2">Create your account</h1>
            <p class="text-muted mb-4">Already a member? <a asp-action="Login" class="fw-bold text-decoration-none">Sign in</a></p>

            <form asp-controller="Account" asp-action="Register" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="row g-3">
                    <div class="col-sm-6">
                        <label asp-for="FirstName" class="form-label">First name</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input asp-for="FirstName" class="form-control" placeholder="Youssef" autocomplete="given-name" />
                        </div>
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="LastName" class="form-label">Last name</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input asp-for="LastName" class="form-control" placeholder="Ibrahim" autocomplete="family-name" />
                        </div>
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Email" class="form-label">Gmail address</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope-at"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="you@gmail.com" autocomplete="email" />
                        </div>
                        <div class="form-text"><i class="bi bi-info-circle me-1"></i>We only accept Gmail accounts for verification.</div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="PhoneNumber" class="form-label">Egyptian phone number</label>
                        <div class="input-group">
                            <span class="input-group-text fw-bold">🇪🇬 +20</span>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="1012345678" inputmode="numeric" maxlength="10" autocomplete="tel-national" id="phoneInput" />
                            <span class="input-group-text d-none" id="phoneOk"><i class="bi bi-check-circle-fill text-success"></i></span>
                        </div>
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-sm-6">
                        <label asp-for="Password" class="form-label">Password</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" class="form-control" type="password" id="passwordInput" placeholder="••••••••" autocomplete="new-password" />
                            <button class="btn btn-light" type="button" data-toggle-password="#passwordInput" aria-label="Show password" tabindex="-1"><i class="bi bi-eye"></i></button>
                        </div>
                        <div class="pc-strength" data-strength-for="#passwordInput" data-score="0" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
                        <div class="form-text" data-strength-label></div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-shield-lock"></i></span>
                            <input asp-for="ConfirmPassword" class="form-control" type="password" id="confirmPasswordInput" placeholder="••••••••" autocomplete="new-password" />
                            <button class="btn btn-light" type="button" data-toggle-password="#confirmPasswordInput" aria-label="Show password" tabindex="-1"><i class="bi bi-eye"></i></button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <div class="form-check form-switch my-4">
                    <input class="form-check-input" type="checkbox" role="switch" id="termsCheck" />
                    <label class="form-check-label small text-muted" for="termsCheck">
                        I agree to the <a asp-controller="Home" asp-action="Privacy" class="fw-semibold text-decoration-none">terms &amp; privacy policy</a>
                    </label>
                    <div class="text-danger small d-none" id="termsError">Please accept the terms to continue.</div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100">
                    Create my account <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        (function () {
            const phone = document.getElementById('phoneInput');
            const ok = document.getElementById('phoneOk');
            phone.addEventListener('input', () => {
                phone.value = phone.value.replace(/[^0-9]/g, '');
                ok.classList.toggle('d-none', !/^1[0125][0-9]{8}$/.test(phone.value));
            });

            const terms = document.getElementById('termsCheck');
            const termsError = document.getElementById('termsError');
            terms.addEventListener('change', () => termsError.classList.toggle('d-none', terms.checked));
            terms.form.addEventListener('submit', e => {
                if (!terms.checked) {
                    e.preventDefault();
                    termsError.classList.remove('d-none');
                    terms.closest('.form-check').animate([{ transform: 'translateX(0)' }, { transform: 'translateX(-6px)' }, { transform: 'translateX(6px)' }, { transform: 'translateX(0)' }], { duration: 300 });
                }
            });
        })();
    </script>
}
