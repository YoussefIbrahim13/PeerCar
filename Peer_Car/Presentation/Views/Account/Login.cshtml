@using Peer_Car.Application.ViewModels
@model LoginViewModel

@{
    ViewData["Title"] = "Sign in";
    ViewData["AuthHeading"] = "Welcome back, driver.";
    ViewData["AuthSub"] = "Sign in to manage your trips, your cars and your bookings.";
}

<div class="pc-auth animate__animated animate__fadeInUp">
    <partial name="_AuthArt" />

    <section class="pc-auth-form">
        <div class="mx-auto w-100" style="max-width: 420px;">
            <span class="eyebrow">Sign in</span>
            <h1 class="mt-2">Good to see you again</h1>
            <p class="text-muted mb-4">Don't have an account? <a asp-action="Register" class="fw-bold text-decoration-none">Create one</a></p>

            <form asp-controller="Account" asp-action="ExternalLogin" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" name="provider" value="Google" class="btn btn-google btn-lg w-100">
                    <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z" /><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z" /><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z" /><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z" /></svg>
                    Continue with Google
                </button>
            </form>

            <div class="pc-divider">or with email</div>

            <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email address</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control form-control-lg" placeholder="name@gmail.com" autocomplete="email" autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <label asp-for="Password" class="form-label">Password</label>
                        <a asp-action="ForgotPassword" asp-controller="Account" class="small fw-semibold text-decoration-none mb-1">Forgot password?</a>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" class="form-control form-control-lg" type="password" id="passwordInput" autocomplete="current-password" placeholder="••••••••" />
                        <button type="button" class="btn btn-light" data-toggle-password="#passwordInput" aria-label="Show password" tabindex="-1">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-check form-switch mb-4">
                    <input asp-for="RememberMe" class="form-check-input" type="checkbox" role="switch" />
                    <label asp-for="RememberMe" class="form-check-label small text-muted">Keep me signed in</label>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100">
                    Sign in <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </form>

            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                if (error.ErrorMessage.Contains("Resend confirmation email"))
                {
                    <div class="alert alert-warning mt-4 small">
                        <i class="bi bi-info-circle me-1"></i> @Html.Raw(error.ErrorMessage)
                    </div>
                }
            }

            <p class="text-center small text-muted mt-4 mb-0">
                <a href="/" class="text-muted text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Back to homepage</a>
            </p>
        </div>
    </section>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
