@{
    ViewData["Title"] = "AI Assistant";
    ViewData["HideFooter"] = true;
    string name = User.Identity?.Name?.Split('@')[0] ?? "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/chatbot.css" asp-append-version="true" />
}

<div class="pc-chat animate__animated animate__fadeInUp">
    <header class="pc-chat-head">
        <div class="pc-chat-avatar"><i class="bi bi-stars"></i><span class="pc-chat-status" id="chatStatus" data-state="connecting"></span></div>
        <div class="flex-grow-1 min-w-0">
            <h1 class="h6 mb-0">PeerCar Assistant</h1>
            <div class="small text-muted" id="chatStatusText">Connecting…</div>
        </div>
        <button type="button" class="pc-icon-btn" id="chatClear" title="Clear conversation" aria-label="Clear conversation"><i class="bi bi-trash3"></i></button>
    </header>

    <div class="pc-chat-body" id="chatMessages" aria-live="polite">
        <div class="pc-chat-intro" id="chatIntro">
            <div class="pc-chat-orb"><i class="bi bi-stars"></i></div>
            <h2 class="h4 mt-3 mb-1" dir="auto">أهلاً @name 👋</h2>
            <p class="text-muted mb-4" dir="auto">أنا مساعدك الذكي في PeerCar. اسألني عن أي عربية، الأسعار، أو إزاي تحجز.</p>
            <div class="pc-chat-suggest">
                <button type="button" data-suggest="رشحلي عربية اقتصادية للمشاوير اليومية">🚗 عربية اقتصادية</button>
                <button type="button" data-suggest="إيه أفضل عربية لرحلة عائلية لإسكندرية؟">👨‍👩‍👧 رحلة عائلية</button>
                <button type="button" data-suggest="إزاي أحجز عربية على PeerCar؟">📅 إزاي أحجز؟</button>
                <button type="button" data-suggest="How do I list my car on PeerCar?">💸 List my car</button>
            </div>
        </div>
    </div>

    <form id="chatForm" class="pc-chat-input" autocomplete="off" data-no-loading>
        <textarea id="userInput" rows="1" dir="auto" placeholder="اسألني عن أي عربية…" aria-label="Message"></textarea>
        <button class="btn btn-primary" type="submit" id="sendBtn" aria-label="Send" disabled>
            <i class="bi bi-arrow-up"></i>
        </button>
    </form>
    <div class="pc-chat-hint small text-muted text-center">Enter to send · Shift + Enter for a new line</div>
</div>

@section Scripts {
    <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
    <script src="~/js/chatbot.js" asp-append-version="true"></script>
}
